{
  "name": "patchproof-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/test-vertical-slice.js",
    "test:r3": "node scripts/test-attack-r3.js",
    "test:all": "vitest run && node scripts/test-vertical-slice.js",
    "dev": "node scripts/dev.js",
    "target:lab": "node scripts/lab-target.js",
    "seed:corpus": "node scripts/corpus-benign.js",
    "build": "npm --workspace=apps/web run build"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
